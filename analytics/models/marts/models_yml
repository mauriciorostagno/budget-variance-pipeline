version: 2

models:
  - name: dim_cost_centers
    description: >
      Mart table for better aggrupation of each cost center.
    columns:
      - name: cost_center_key
        description: identifier for each cost center.
        data_tests:
          - unique
          - not_null
      - name: cost_center_name
        description: name of each cost center.
      - name: area
        description: area of each cost center.
      - name: owner
        description: owner of the area.

  - name: dim_vendors
    description: >
      Mart table for better aggrupation of each vendor.
    columns:
      - name: vendor_key
        description: identifier for each vendor.
        data_tests:
          - unique
          - not_null
      - name: vendor_name
        description: name of each vendor.
      - name: vendor_type
        description: type of vendor.
      - name: country
        description: country of the vendor.

  - name: fct_invoices
    description: >
      Mart table with all the information of each invoice created.
    columns:
      - name: invoice_id
        description: identifier for each invoice.
        data_tests:
          - unique
          - not_null
      - name: vendor_key
        description: identifier of each vendor.
        data_tests:
          - relationships:
              arguments:
                to: ref('dim_vendors')
                field: vendor_key
              config:
                severity: error
      - name: cost_center_key
        description: identifier of each cost_center.
        data_tests:
          - relationships:
              arguments:
                to: ref('dim_cost_centers')
                field: cost_center_key
              config:
                severity: error
      - name: issue_date
        description: date of each invoice.
      - name: due_date
        description: due of the invoice.
      - name: budget_month
        description: month of the invoice.
      - name: status
        description:
      - name: expense_category_raw
        description:
      - name: transaction_type
        description:
      - name: description
        description:
      - name: amount
        description:
      - name: currency
        description:
      - name: amount_usd
        description:
      - name: rate_to_usd
        description:
      - name: is_rate_filled
        description:
